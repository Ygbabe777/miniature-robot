# Copy to .env and fill in. NEVER commit the real .env file.

# --- Database ---
DATABASE_URL=postgresql+psycopg://quant:quant@localhost:5432/quant_agent
REDIS_URL=redis://localhost:6379/0

# --- Operating mode ---
# One of: FULL_AUTO_RESEARCH, AUTO_PAPER, HUMAN_APPROVAL, FULL_AUTO_LIVE
QUANT_AGENT_MODE=HUMAN_APPROVAL
ALLOW_FULL_AUTO_LIVE=false

# --- LLM backend for paper understanding / hypothesis generation ---
# If unset, the system falls back to a deterministic rule-based extractor
# (lower quality, clearly logged as such in paper_understanding records).
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5

# --- Research sources ---
# arXiv requires no key. Everything below requires a partnership/API key
# the system does not assume you have; leave blank to keep those sources
# disabled (research_agent will skip them and log why).
SEMANTIC_SCHOLAR_API_KEY=
CROSSREF_MAILTO=
SSRN_API_KEY=

# --- Embeddings / vector store ---
EMBEDDING_BACKEND=none        # none | openai | anthropic | local
QDRANT_URL=
QDRANT_API_KEY=

# --- Experiment tracking ---
MLFLOW_TRACKING_URI=

# --- Broker credentials (live execution — NOT implemented in this build) ---
IBKR_HOST=
IBKR_PORT=
IBKR_CLIENT_ID=
TRADOVATE_API_KEY=
TRADOVATE_API_SECRET=
NINJATRADER_HOST=

# --- Experiment budget ---
MAX_DAILY_EXPERIMENTS=50
MAX_CONCURRENT_BACKTESTS=4
MAX_STRATEGY_VARIANTS_PER_HYPOTHESIS=8
MAX_PARAMETER_SEARCH_SIZE=200
MAX_LLM_CALLS_PER_DAY=500
MAX_RESEARCH_PAPERS_PER_DAY=100

# --- Alerts ---
ALERT_WEBHOOK_URL=
