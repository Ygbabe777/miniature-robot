// This source code is subject to the terms of the Mozilla Public License 2.0
// © Session Levels & Initial Balance — Pine Script v6
//@version=6
indicator("Session Levels & IB Pro", shorttitle="SLIB Pro", overlay=true, max_lines_count=200, max_boxes_count=100, max_labels_count=200, max_bars_back=500)

// Uso consigliato: timeframe intraday (1m–1h). I livelli di sessione si
// aggiornano automaticamente ogni giorno in base al fuso orario scelto.
// Tutti i prezzi restano visibili sul grafico (linee + etichette) per lo
// screenshot giornaliero, senza doverli scrivere a mano.

// ═══════════════════════════════════════════════════════════════════
// INPUT — Gruppo: Generali
// ═══════════════════════════════════════════════════════════════════
i_tz          = input.string("Europe/Rome", "Fuso orario sessioni", group="Generali",
                   tooltip="Fuso orario usato per definire gli orari di Asia/London/NY/IB. Es: Europe/Rome, America/New_York, Etc/UTC")
i_labelOffset = input.int(12, "Offset etichette prezzo (barre a destra)", minval=1, maxval=200, group="Generali")
i_labelSize   = input.string(size.small, "Dimensione testo etichette", group="Generali",
                   options=[size.tiny, size.small, size.normal, size.large])
i_lineWidth   = input.int(1, "Spessore linee livelli", minval=1, maxval=4, group="Generali")

// ═══════════════════════════════════════════════════════════════════
// INPUT — Gruppo: Giorno Precedente (PDOHLC)
// ═══════════════════════════════════════════════════════════════════
i_showPD   = input.bool(true, "Mostra livelli Giorno Precedente", group="Giorno Precedente")
i_showPDO  = input.bool(true, "  Open", group="Giorno Precedente", inline="pdA")
i_showPDH  = input.bool(true, "  High", group="Giorno Precedente", inline="pdA")
i_showPDL  = input.bool(true, "  Low", group="Giorno Precedente", inline="pdB")
i_showPDC  = input.bool(true, "  Close", group="Giorno Precedente", inline="pdB")
i_colPDO   = input.color(color.new(#9E9E9E, 0), "Colore Open", group="Giorno Precedente")
i_colPDH   = input.color(color.new(#2962FF, 0), "Colore High", group="Giorno Precedente")
i_colPDL   = input.color(color.new(#2962FF, 0), "Colore Low", group="Giorno Precedente")
i_colPDC   = input.color(color.new(#787B86, 0), "Colore Close", group="Giorno Precedente")
i_pdStyle  = input.string("Dashed", "Stile linee PD", group="Giorno Precedente", options=["Solid", "Dashed", "Dotted"])

// ═══════════════════════════════════════════════════════════════════
// INPUT — Gruppo: Sessione Asia
// ═══════════════════════════════════════════════════════════════════
i_showAsia   = input.bool(true, "Mostra sessione Asia", group="Sessione Asia")
i_asiaSess   = input.session("0000-0900", "Orario Asia", group="Sessione Asia")
i_colAsia    = input.color(color.new(#FF6D00, 0), "Colore Asia", group="Sessione Asia")
i_bgAsia     = input.bool(true, "Sfondo sessione Asia", group="Sessione Asia")
i_bgAsiaTr   = input.int(94, "Trasparenza sfondo Asia", minval=50, maxval=99, group="Sessione Asia")

// ═══════════════════════════════════════════════════════════════════
// INPUT — Gruppo: Sessione London
// ═══════════════════════════════════════════════════════════════════
i_showLondon = input.bool(true, "Mostra sessione London", group="Sessione London")
i_londonSess = input.session("0900-1530", "Orario London", group="Sessione London")
i_colLondon  = input.color(color.new(#00C853, 0), "Colore London", group="Sessione London")
i_bgLondon   = input.bool(true, "Sfondo sessione London", group="Sessione London")
i_bgLondonTr = input.int(94, "Trasparenza sfondo London", minval=50, maxval=99, group="Sessione London")

// ═══════════════════════════════════════════════════════════════════
// INPUT — Gruppo: Sessione New York
// ═══════════════════════════════════════════════════════════════════
i_showNY   = input.bool(true, "Mostra sessione New York", group="Sessione New York")
i_nySess   = input.session("1530-2200", "Orario New York", group="Sessione New York")
i_colNY    = input.color(color.new(#D500F9, 0), "Colore New York", group="Sessione New York")
i_bgNY     = input.bool(true, "Sfondo sessione New York", group="Sessione New York")
i_bgNYTr   = input.int(94, "Trasparenza sfondo New York", minval=50, maxval=99, group="Sessione New York")

// ═══════════════════════════════════════════════════════════════════
// INPUT — Gruppo: Initial Balance (primi 30 min NY)
// ═══════════════════════════════════════════════════════════════════
i_showIB    = input.bool(true, "Mostra Initial Balance", group="Initial Balance")
i_ibSess    = input.session("1530-1600", "Orario IB", group="Initial Balance")
i_colIB     = input.color(color.new(#FFD600, 0), "Colore IB", group="Initial Balance")
i_ibBoxTr   = input.int(85, "Trasparenza box IB", minval=0, maxval=99, group="Initial Balance")

// ═══════════════════════════════════════════════════════════════════
// INPUT — Gruppo: Statistiche di rottura
// ═══════════════════════════════════════════════════════════════════
i_showStats  = input.bool(true, "Mostra tabella statistiche", group="Statistiche")
i_statsPos   = input.string("Alto Destra", "Posizione tabella", group="Statistiche",
                  options=["Alto Destra", "Alto Sinistra", "Basso Destra", "Basso Sinistra"])
i_statsSize  = input.string(size.small, "Dimensione testo tabella", group="Statistiche",
                  options=[size.tiny, size.small, size.normal])

// ═══════════════════════════════════════════════════════════════════
// FUNZIONI DI SUPPORTO
// ═══════════════════════════════════════════════════════════════════
f_lineStyle(s) =>
    s == "Dashed" ? line.style_dashed : s == "Dotted" ? line.style_dotted : line.style_solid

f_pct(brokenCount, total) =>
    total > 0 ? str.tostring(brokenCount / total * 100, "#.#") + "%  (" + str.tostring(brokenCount) + "/" + str.tostring(total) + ")" : "n/d"

// ═══════════════════════════════════════════════════════════════════
// GIORNO PRECEDENTE — Open / High / Low / Close (no repaint)
// ═══════════════════════════════════════════════════════════════════
[pdo, pdh, pdl, pdc] = request.security(syminfo.tickerid, "D", [open[1], high[1], low[1], close[1]], lookahead=barmerge.lookahead_off)

newDay = dayofmonth(time, i_tz) != dayofmonth(time[1], i_tz)

var int pdStartIdx = na
if newDay
    pdStartIdx := bar_index

// ═══════════════════════════════════════════════════════════════════
// RILEVAMENTO SESSIONI (fuso orario configurabile)
// ═══════════════════════════════════════════════════════════════════
inAsia   = not na(time(timeframe.period, i_asiaSess, i_tz))
inLondon = not na(time(timeframe.period, i_londonSess, i_tz))
inNY     = not na(time(timeframe.period, i_nySess, i_tz))
inIB     = not na(time(timeframe.period, i_ibSess, i_tz))

asiaStart   = inAsia and not inAsia[1]
asiaEndBar  = not inAsia and inAsia[1]
londonStart = inLondon and not inLondon[1]
londonEndBar= not inLondon and inLondon[1]
nyStart     = inNY and not inNY[1]
nyEndBar    = not inNY and inNY[1]
ibStart     = inIB and not inIB[1]
ibEndBar    = not inIB and inIB[1]

// ── Asia High/Low ─────────────────────────────────────────────────
var float asiaHigh = na
var float asiaLow  = na
var int   asiaStartIdx = na
if asiaStart
    asiaHigh := high
    asiaLow  := low
    asiaStartIdx := bar_index
else if inAsia
    asiaHigh := math.max(asiaHigh, high)
    asiaLow  := math.min(asiaLow, low)

// ── London High/Low ───────────────────────────────────────────────
var float londonHigh = na
var float londonLow  = na
var int   londonStartIdx = na
if londonStart
    londonHigh := high
    londonLow  := low
    londonStartIdx := bar_index
else if inLondon
    londonHigh := math.max(londonHigh, high)
    londonLow  := math.min(londonLow, low)

// ── New York High/Low ─────────────────────────────────────────────
var float nyHigh = na
var float nyLow  = na
var int   nyStartIdx = na
if nyStart
    nyHigh := high
    nyLow  := low
    nyStartIdx := bar_index
else if inNY
    nyHigh := math.max(nyHigh, high)
    nyLow  := math.min(nyLow, low)

// ── Initial Balance (primi 30 min NY) ─────────────────────────────
var float ibHigh = na
var float ibLow  = na
var int   ibStartIdx = na
if ibStart
    ibHigh := high
    ibLow  := low
    ibStartIdx := bar_index
else if inIB
    ibHigh := math.max(ibHigh, high)
    ibLow  := math.min(ibLow, low)

// ═══════════════════════════════════════════════════════════════════
// STATISTICHE DI ROTTURA — quante volte i livelli vengono violati
// ═══════════════════════════════════════════════════════════════════
// -- PDH / PDL: rotti durante l'intera giornata corrente -----------
var bool pdHighBroken = false
var bool pdLowBroken  = false
var int  pdTotal = 0
var int  pdHighBrokenCnt = 0
var int  pdLowBrokenCnt  = 0

if newDay and not na(pdh[1])
    pdTotal += 1
    if pdHighBroken
        pdHighBrokenCnt += 1
    if pdLowBroken
        pdLowBrokenCnt += 1
    pdHighBroken := false
    pdLowBroken  := false

if not na(pdh)
    if high > pdh
        pdHighBroken := true
    if low < pdl
        pdLowBroken := true

// -- Asia H/L: rotti dopo la chiusura della sessione (London+NY) ---
var bool armedAsia = false
var bool asiaHighBroken = false
var bool asiaLowBroken  = false
var int  asiaTotal = 0
var int  asiaHighBrokenCnt = 0
var int  asiaLowBrokenCnt  = 0

if newDay
    if armedAsia
        asiaTotal += 1
        if asiaHighBroken
            asiaHighBrokenCnt += 1
        if asiaLowBroken
            asiaLowBrokenCnt += 1
    armedAsia := false
    asiaHighBroken := false
    asiaLowBroken  := false

if asiaEndBar
    armedAsia := true

if armedAsia
    if high > asiaHigh
        asiaHighBroken := true
    if low < asiaLow
        asiaLowBroken := true

// -- London H/L: rotti durante la sessione NY -----------------------
var bool armedLondon = false
var bool londonHighBroken = false
var bool londonLowBroken  = false
var int  londonTotal = 0
var int  londonHighBrokenCnt = 0
var int  londonLowBrokenCnt  = 0

if newDay
    if armedLondon
        londonTotal += 1
        if londonHighBroken
            londonHighBrokenCnt += 1
        if londonLowBroken
            londonLowBrokenCnt += 1
    armedLondon := false
    londonHighBroken := false
    londonLowBroken  := false

if londonEndBar
    armedLondon := true

if armedLondon
    if high > londonHigh
        londonHighBroken := true
    if low < londonLow
        londonLowBroken := true

// -- NY H/L: rotti dalla sessione Asia del giorno successivo --------
var bool armedNY = false
var bool nyHighBroken = false
var bool nyLowBroken  = false
var int  nyTotal = 0
var int  nyHighBrokenCnt = 0
var int  nyLowBrokenCnt  = 0

if asiaEndBar
    if armedNY
        nyTotal += 1
        if nyHighBroken
            nyHighBrokenCnt += 1
        if nyLowBroken
            nyLowBrokenCnt += 1
    armedNY := false
    nyHighBroken := false
    nyLowBroken  := false

if nyEndBar
    armedNY := true

if armedNY
    if high > nyHigh
        nyHighBroken := true
    if low < nyLow
        nyLowBroken := true

// -- IB H/L: rotti nel resto della sessione NY -----------------------
var bool armedIB = false
var bool ibHighBroken = false
var bool ibLowBroken  = false
var int  ibTotal = 0
var int  ibHighBrokenCnt = 0
var int  ibLowBrokenCnt  = 0

if newDay
    if armedIB
        ibTotal += 1
        if ibHighBroken
            ibHighBrokenCnt += 1
        if ibLowBroken
            ibLowBrokenCnt += 1
    armedIB := false
    ibHighBroken := false
    ibLowBroken  := false

if ibEndBar
    armedIB := true

if armedIB
    if high > ibHigh
        ibHighBroken := true
    if low < ibLow
        ibLowBroken := true

// ═══════════════════════════════════════════════════════════════════
// SFONDO SESSIONI (facoltativo, per contesto visivo)
// ═══════════════════════════════════════════════════════════════════
bgcolor(i_showAsia and i_bgAsia and inAsia ? color.new(i_colAsia, i_bgAsiaTr) : na, title="Sfondo Asia")
bgcolor(i_showLondon and i_bgLondon and inLondon ? color.new(i_colLondon, i_bgLondonTr) : na, title="Sfondo London")
bgcolor(i_showNY and i_bgNY and inNY ? color.new(i_colNY, i_bgNYTr) : na, title="Sfondo New York")

// ═══════════════════════════════════════════════════════════════════
// DISEGNO LIVELLI — linee + etichette con prezzo (xloc = bar_index)
// ═══════════════════════════════════════════════════════════════════
f_priceTxt(p) => na(p) ? "—" : str.tostring(p, format.mintick)

// -- oggetti persistenti (creati una sola volta, poi aggiornati) ----
var line  pdoLine = na
var label pdoLbl  = na
var line  pdhLine = na
var label pdhLbl  = na
var line  pdlLine = na
var label pdlLbl  = na
var line  pdcLine = na
var label pdcLbl  = na
var line  asiaHLine = na
var label asiaHLbl  = na
var line  asiaLLine = na
var label asiaLLbl  = na
var line  londonHLine = na
var label londonHLbl  = na
var line  londonLLine = na
var label londonLLbl  = na
var line  nyHLine = na
var label nyHLbl  = na
var line  nyLLine = na
var label nyLLbl  = na
var line  ibHLine = na
var label ibHLbl  = na
var line  ibLLine = na
var label ibLLbl  = na
var box   ibBox = na

pdLineStyle = f_lineStyle(i_pdStyle)

// PDO ----------------------------------------------------------------
if i_showPD and i_showPDO and not na(pdo)
    txt = "PDO  " + f_priceTxt(pdo)
    if na(pdoLine)
        pdoLine := line.new(pdStartIdx, pdo, bar_index, pdo, xloc=xloc.bar_index, color=i_colPDO, style=pdLineStyle, width=i_lineWidth, extend=extend.right)
        pdoLbl  := label.new(bar_index + i_labelOffset, pdo, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(i_colPDO, 0), textcolor=color.white, size=i_labelSize)
    else
        line.set_xy1(pdoLine, pdStartIdx, pdo)
        line.set_xy2(pdoLine, bar_index, pdo)
        label.set_xy(pdoLbl, bar_index + i_labelOffset, pdo)
        label.set_text(pdoLbl, txt)

// PDH ----------------------------------------------------------------
if i_showPD and i_showPDH and not na(pdh)
    txt = "PDH  " + f_priceTxt(pdh)
    if na(pdhLine)
        pdhLine := line.new(pdStartIdx, pdh, bar_index, pdh, xloc=xloc.bar_index, color=i_colPDH, style=pdLineStyle, width=i_lineWidth, extend=extend.right)
        pdhLbl  := label.new(bar_index + i_labelOffset, pdh, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(i_colPDH, 0), textcolor=color.white, size=i_labelSize)
    else
        line.set_xy1(pdhLine, pdStartIdx, pdh)
        line.set_xy2(pdhLine, bar_index, pdh)
        label.set_xy(pdhLbl, bar_index + i_labelOffset, pdh)
        label.set_text(pdhLbl, txt)

// PDL ----------------------------------------------------------------
if i_showPD and i_showPDL and not na(pdl)
    txt = "PDL  " + f_priceTxt(pdl)
    if na(pdlLine)
        pdlLine := line.new(pdStartIdx, pdl, bar_index, pdl, xloc=xloc.bar_index, color=i_colPDL, style=pdLineStyle, width=i_lineWidth, extend=extend.right)
        pdlLbl  := label.new(bar_index + i_labelOffset, pdl, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(i_colPDL, 0), textcolor=color.white, size=i_labelSize)
    else
        line.set_xy1(pdlLine, pdStartIdx, pdl)
        line.set_xy2(pdlLine, bar_index, pdl)
        label.set_xy(pdlLbl, bar_index + i_labelOffset, pdl)
        label.set_text(pdlLbl, txt)

// PDC ----------------------------------------------------------------
if i_showPD and i_showPDC and not na(pdc)
    txt = "PDC  " + f_priceTxt(pdc)
    if na(pdcLine)
        pdcLine := line.new(pdStartIdx, pdc, bar_index, pdc, xloc=xloc.bar_index, color=i_colPDC, style=pdLineStyle, width=i_lineWidth, extend=extend.right)
        pdcLbl  := label.new(bar_index + i_labelOffset, pdc, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(i_colPDC, 0), textcolor=color.white, size=i_labelSize)
    else
        line.set_xy1(pdcLine, pdStartIdx, pdc)
        line.set_xy2(pdcLine, bar_index, pdc)
        label.set_xy(pdcLbl, bar_index + i_labelOffset, pdc)
        label.set_text(pdcLbl, txt)

// Asia High ------------------------------------------------------------
if i_showAsia and not na(asiaHigh)
    txt = "Asia H  " + f_priceTxt(asiaHigh)
    if na(asiaHLine)
        asiaHLine := line.new(asiaStartIdx, asiaHigh, bar_index, asiaHigh, xloc=xloc.bar_index, color=i_colAsia, style=line.style_dotted, width=i_lineWidth, extend=extend.right)
        asiaHLbl  := label.new(bar_index + i_labelOffset, asiaHigh, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(i_colAsia, 0), textcolor=color.white, size=i_labelSize)
    else
        line.set_xy1(asiaHLine, asiaStartIdx, asiaHigh)
        line.set_xy2(asiaHLine, bar_index, asiaHigh)
        label.set_xy(asiaHLbl, bar_index + i_labelOffset, asiaHigh)
        label.set_text(asiaHLbl, txt)

// Asia Low ------------------------------------------------------------
if i_showAsia and not na(asiaLow)
    txt = "Asia L  " + f_priceTxt(asiaLow)
    if na(asiaLLine)
        asiaLLine := line.new(asiaStartIdx, asiaLow, bar_index, asiaLow, xloc=xloc.bar_index, color=i_colAsia, style=line.style_dotted, width=i_lineWidth, extend=extend.right)
        asiaLLbl  := label.new(bar_index + i_labelOffset, asiaLow, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(i_colAsia, 0), textcolor=color.white, size=i_labelSize)
    else
        line.set_xy1(asiaLLine, asiaStartIdx, asiaLow)
        line.set_xy2(asiaLLine, bar_index, asiaLow)
        label.set_xy(asiaLLbl, bar_index + i_labelOffset, asiaLow)
        label.set_text(asiaLLbl, txt)

// London High ------------------------------------------------------------
if i_showLondon and not na(londonHigh)
    txt = "London H  " + f_priceTxt(londonHigh)
    if na(londonHLine)
        londonHLine := line.new(londonStartIdx, londonHigh, bar_index, londonHigh, xloc=xloc.bar_index, color=i_colLondon, style=line.style_dotted, width=i_lineWidth, extend=extend.right)
        londonHLbl  := label.new(bar_index + i_labelOffset, londonHigh, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(i_colLondon, 0), textcolor=color.white, size=i_labelSize)
    else
        line.set_xy1(londonHLine, londonStartIdx, londonHigh)
        line.set_xy2(londonHLine, bar_index, londonHigh)
        label.set_xy(londonHLbl, bar_index + i_labelOffset, londonHigh)
        label.set_text(londonHLbl, txt)

// London Low ------------------------------------------------------------
if i_showLondon and not na(londonLow)
    txt = "London L  " + f_priceTxt(londonLow)
    if na(londonLLine)
        londonLLine := line.new(londonStartIdx, londonLow, bar_index, londonLow, xloc=xloc.bar_index, color=i_colLondon, style=line.style_dotted, width=i_lineWidth, extend=extend.right)
        londonLLbl  := label.new(bar_index + i_labelOffset, londonLow, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(i_colLondon, 0), textcolor=color.white, size=i_labelSize)
    else
        line.set_xy1(londonLLine, londonStartIdx, londonLow)
        line.set_xy2(londonLLine, bar_index, londonLow)
        label.set_xy(londonLLbl, bar_index + i_labelOffset, londonLow)
        label.set_text(londonLLbl, txt)

// New York High ------------------------------------------------------------
if i_showNY and not na(nyHigh)
    txt = "NY H  " + f_priceTxt(nyHigh)
    if na(nyHLine)
        nyHLine := line.new(nyStartIdx, nyHigh, bar_index, nyHigh, xloc=xloc.bar_index, color=i_colNY, style=line.style_dotted, width=i_lineWidth, extend=extend.right)
        nyHLbl  := label.new(bar_index + i_labelOffset, nyHigh, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(i_colNY, 0), textcolor=color.white, size=i_labelSize)
    else
        line.set_xy1(nyHLine, nyStartIdx, nyHigh)
        line.set_xy2(nyHLine, bar_index, nyHigh)
        label.set_xy(nyHLbl, bar_index + i_labelOffset, nyHigh)
        label.set_text(nyHLbl, txt)

// New York Low ------------------------------------------------------------
if i_showNY and not na(nyLow)
    txt = "NY L  " + f_priceTxt(nyLow)
    if na(nyLLine)
        nyLLine := line.new(nyStartIdx, nyLow, bar_index, nyLow, xloc=xloc.bar_index, color=i_colNY, style=line.style_dotted, width=i_lineWidth, extend=extend.right)
        nyLLbl  := label.new(bar_index + i_labelOffset, nyLow, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(i_colNY, 0), textcolor=color.white, size=i_labelSize)
    else
        line.set_xy1(nyLLine, nyStartIdx, nyLow)
        line.set_xy2(nyLLine, bar_index, nyLow)
        label.set_xy(nyLLbl, bar_index + i_labelOffset, nyLow)
        label.set_text(nyLLbl, txt)

// IB High ------------------------------------------------------------
if i_showIB and not na(ibHigh)
    txt = "IB H  " + f_priceTxt(ibHigh)
    if na(ibHLine)
        ibHLine := line.new(ibStartIdx, ibHigh, bar_index, ibHigh, xloc=xloc.bar_index, color=i_colIB, style=line.style_solid, width=i_lineWidth, extend=extend.right)
        ibHLbl  := label.new(bar_index + i_labelOffset, ibHigh, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(i_colIB, 0), textcolor=color.black, size=i_labelSize)
    else
        line.set_xy1(ibHLine, ibStartIdx, ibHigh)
        line.set_xy2(ibHLine, bar_index, ibHigh)
        label.set_xy(ibHLbl, bar_index + i_labelOffset, ibHigh)
        label.set_text(ibHLbl, txt)

// IB Low ------------------------------------------------------------
if i_showIB and not na(ibLow)
    txt = "IB L  " + f_priceTxt(ibLow)
    if na(ibLLine)
        ibLLine := line.new(ibStartIdx, ibLow, bar_index, ibLow, xloc=xloc.bar_index, color=i_colIB, style=line.style_solid, width=i_lineWidth, extend=extend.right)
        ibLLbl  := label.new(bar_index + i_labelOffset, ibLow, txt, xloc=xloc.bar_index, style=label.style_label_left, color=color.new(i_colIB, 0), textcolor=color.black, size=i_labelSize)
    else
        line.set_xy1(ibLLine, ibStartIdx, ibLow)
        line.set_xy2(ibLLine, bar_index, ibLow)
        label.set_xy(ibLLbl, bar_index + i_labelOffset, ibLow)
        label.set_text(ibLLbl, txt)

// -- box Initial Balance (evidenzia il range dei primi 30 minuti) ---
if i_showIB and ibStart
    if na(ibBox)
        ibBox := box.new(ibStartIdx, high, ibStartIdx, low, border_color=color.new(i_colIB, 40), bgcolor=color.new(i_colIB, i_ibBoxTr))
    else
        box.set_lefttop(ibBox, ibStartIdx, high)
        box.set_rightbottom(ibBox, ibStartIdx, low)

if i_showIB and inIB and not na(ibBox)
    box.set_lefttop(ibBox, ibStartIdx, ibHigh)
    box.set_rightbottom(ibBox, bar_index, ibLow)

// ═══════════════════════════════════════════════════════════════════
// TABELLA STATISTICHE DI ROTTURA
// ═══════════════════════════════════════════════════════════════════
f_tablePos(p) =>
    p == "Alto Sinistra" ? position.top_left : p == "Basso Destra" ? position.bottom_right : p == "Basso Sinistra" ? position.bottom_left : position.top_right

var table statsTbl = na

if i_showStats and barstate.islast
    if na(statsTbl)
        statsTbl := table.new(f_tablePos(i_statsPos), 2, 11, border_width=1)
    table.cell(statsTbl, 0, 0, "LIVELLO", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=i_statsSize)
    table.cell(statsTbl, 1, 0, "% ROTTURA", bgcolor=color.new(color.black, 0), text_color=color.white, text_size=i_statsSize)

    rowBg = color.new(color.gray, 88)

    table.cell(statsTbl, 0, 1, "PDH", text_color=i_colPDH, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 1, 1, f_pct(pdHighBrokenCnt, pdTotal), text_color=color.white, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 0, 2, "PDL", text_color=i_colPDL, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 1, 2, f_pct(pdLowBrokenCnt, pdTotal), text_color=color.white, bgcolor=rowBg, text_size=i_statsSize)

    table.cell(statsTbl, 0, 3, "Asia High", text_color=i_colAsia, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 1, 3, f_pct(asiaHighBrokenCnt, asiaTotal), text_color=color.white, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 0, 4, "Asia Low", text_color=i_colAsia, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 1, 4, f_pct(asiaLowBrokenCnt, asiaTotal), text_color=color.white, bgcolor=rowBg, text_size=i_statsSize)

    table.cell(statsTbl, 0, 5, "London High", text_color=i_colLondon, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 1, 5, f_pct(londonHighBrokenCnt, londonTotal), text_color=color.white, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 0, 6, "London Low", text_color=i_colLondon, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 1, 6, f_pct(londonLowBrokenCnt, londonTotal), text_color=color.white, bgcolor=rowBg, text_size=i_statsSize)

    table.cell(statsTbl, 0, 7, "NY High", text_color=i_colNY, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 1, 7, f_pct(nyHighBrokenCnt, nyTotal), text_color=color.white, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 0, 8, "NY Low", text_color=i_colNY, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 1, 8, f_pct(nyLowBrokenCnt, nyTotal), text_color=color.white, bgcolor=rowBg, text_size=i_statsSize)

    table.cell(statsTbl, 0, 9, "IB High", text_color=i_colIB, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 1, 9, f_pct(ibHighBrokenCnt, ibTotal), text_color=color.white, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 0, 10, "IB Low", text_color=i_colIB, bgcolor=rowBg, text_size=i_statsSize)
    table.cell(statsTbl, 1, 10, f_pct(ibLowBrokenCnt, ibTotal), text_color=color.white, bgcolor=rowBg, text_size=i_statsSize)
